{
  "name": "campus-lunch-discord-bot",
  "version": "1.2.0",
  "description": "Discord bot for distributing university lunch menus to multiple Discord servers",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "dev": "NODE_ENV=development node src/bot.js",
    "start:all": "node scripts/startAll.js",
    "waha": "node scripts/localWahaServer.js",
    "relay": "node src/relay.js",
    "relay:latest": "node scripts/relayLatestFromDiscord.js",
    "register": "node scripts/registerGlobalCommands.js",
    "publishNow": "node scripts/publishNow.js",
    "whatsapp:status": "node scripts/whatsappSetup.js status",
    "whatsapp:pair": "node scripts/whatsappSetup.js pair",
    "whatsapp:channels": "node scripts/whatsappSetup.js channels",
    "whatsapp:publish": "node scripts/publishWhatsappNow.js",
    "check:data": "node scripts/checkMenuData.js",
    "fix:campus": "node scripts/fixCampusLabels.js",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "discord",
    "bot",
    "menu",
    "automation"
  ],
  "author": "Campus Lunch Pipeline",
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "discord.js": "^14.14.0",
    "dotenv": "^16.3.1",
    "node-schedule": "^2.1.1",
    "pg": "^8.11.3",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
