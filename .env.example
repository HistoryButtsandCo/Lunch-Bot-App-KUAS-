# Discord
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

BOT_ADMIN_ID=your_discord_user_id   # Receives DM alerts on delivery failures (optional)

# PostgreSQL
POSTGRES_USER=campus_lunch_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campus_lunch

# Uptime Kuma push monitors (optional — leave blank to disable)
# Create a "Push" monitor in Uptime Kuma, then paste its push URL here:
UPTIME_KUMA_HEARTBEAT_URL=   # bot pings this every 5 min (liveness check)
UPTIME_KUMA_MENU_PUSH_URL=   # pinged after each publisher run; reports DOWN if a
                             # menu was published but reached nobody
UPTIME_KUMA_DATA_PUSH_URL=   # pinged by `npm run check:data`; reports DOWN when the
                             # scraped menu data is missing, mislabelled or unpriced
HEALTH_PORT=3000              # port for /api/status health endpoint (503 when degraded)
                              # also serves the admin dashboard at /dashboard

# Admin dashboard — leave unset on a trusted LAN and the dashboard is read-only.
# Setting a token locks the read endpoints behind it AND enables the re-publish
# button, which is disabled entirely while this is unset.
DASHBOARD_TOKEN=              # e.g. `openssl rand -hex 24`

# Menu data quality check — how far ahead `npm run check:data` looks
DATA_CHECK_WINDOW_DAYS=21

# WhatsApp Channel via WAHA (optional — leave blank to disable)
# Run WAHA: `docker compose -f deploy/docker-compose.waha.yml up -d`
# Discover channel ID: `npm run whatsapp:channels`
WAHA_API_URL=http://localhost:3001
WAHA_API_KEY=                # Optional X-Api-Key if configured on WAHA
WAHA_SESSION=default
WHATSAPP_CHANNEL_ID=         # e.g. 120363123456789012@newsletter
WHATSAPP_CAMPUSES=Uzumasa    # Comma-separated: Uzumasa (or Uzumasa,Kameoka)
# Optional per-campus channel overrides (if posting campuses to different channels):
WHATSAPP_CHANNEL_ID_UZUMASA=
WHATSAPP_CHANNEL_ID_KAMEOKA=

# Standalone Discord → WhatsApp Relay (Path C — no PostgreSQL needed; run `npm run relay`)
RELAY_DISCORD_CHANNEL_ID=    # Discord channel ID where the Lunch Bot posts menus
RELAY_SOURCE_BOT_ID=         # Optional: filter by the upstream Lunch Bot's Discord user ID

# App
NODE_ENV=production
LOG_LEVEL=info
